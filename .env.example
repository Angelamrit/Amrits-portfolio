# Copy to .env.local and fill in. Never commit .env.local.

# --- Site ---
# Canonical URL used for metadata, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://chefamritpalsingh.com
# "true" reveals draft articles and placeholder content. Keep false in production.
NEXT_PUBLIC_SHOW_PLACEHOLDERS=false

# --- Enquiry email (Resend) ---
# Without RESEND_API_KEY and INQUIRY_TO_EMAIL, enquiries are logged to the
# server console as [inquiry:dry-run] and the visitor still sees the success state.
RESEND_API_KEY=
INQUIRY_TO_EMAIL=
INQUIRY_FROM_EMAIL=Chef Amrit Pal Singh <inquiries@yourdomain.com>

# --- Chatbot (Google Gemini) ---
# Server-side only. Never prefix this with NEXT_PUBLIC_ — that would inline the
# key into the browser bundle. Get a key from https://aistudio.google.com/apikey
# Without it the assistant stays reachable and replies with the restaurant's
# phone and email instead of calling Gemini.
GEMINI_API_KEY=
