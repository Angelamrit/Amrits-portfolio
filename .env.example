# Copy to .env.local for development. For the live site on a VPS, the same
# settings go in .env.production in the app folder on the server, which
# "next build" and "next start" read by themselves; rebuild and restart after
# any change. Never commit a filled-in copy: .gitignore already excludes .env*.
#
# The minimum for a VPS: RESEND_API_KEY, INQUIRY_TO_EMAIL, ADMIN_PASSWORD_HASH,
# OPENAI_API_KEY, DATA_DIR and TRUSTED_IP_HEADER. Leave the "Vercel only"
# section empty.

# ---------------------------------------------------------------------------
# Enquiry email (required in production)
# ---------------------------------------------------------------------------
# Without both of these the contact form runs as a dry run in development: it
# logs the enquiry to the server console. In production the site still serves,
# but the server prints a warning at startup and the contact form asks guests
# to telephone instead of claiming their message was sent — see src/lib/env.ts.

# API key from https://resend.com/api-keys. Check it with:  npm run email:test
RESEND_API_KEY=

# Where enquiries are delivered. One address, or several separated by commas.
INQUIRY_TO_EMAIL=angelrestaurant278@gmail.com

# Optional. The From address on the enquiry and the guest auto-reply. Must be on
# a domain you own and have verified in Resend: a Gmail address cannot be used
# here. Defaults to Resend's shared test sender, which can only deliver to the
# email address the Resend account was created with, so until a domain is
# verified the guest auto-reply will not reach guests. (Create the Resend
# account with the INQUIRY_TO_EMAIL address, and enquiries still arrive.)
#
# Leave it unset until the domain shows "Verified" at resend.com/domains.
# Resend refuses EVERY email from an unverified domain (checked: it answers
# "The chefamritpalsingh.com domain is not verified"), so setting it early
# stops enquiries reaching the restaurant. Once verified, set for example:
#   INQUIRY_FROM_EMAIL=Chef Amrit Pal Singh <chef@chefamritpalsingh.com>
# and check with:  npm run email:test
INQUIRY_FROM_EMAIL=

# Optional. Signs the invisible anti-bot challenge behind the contact form.
# When unset it is derived from RESEND_API_KEY, so a normal deploy needs
# nothing here. Set it explicitly on a host that runs several instances
# without a mail key, or to keep open forms valid across a key rotation.
# At least 16 characters. Generate with:  openssl rand -base64 32
INQUIRY_CHALLENGE_SECRET=

# Which request header carries the visitor's real address. The visitor
# numbers and the contact form's limits both depend on it.
#
# On a VPS behind nginx: set it to  x-real-ip  and have nginx send
#   proxy_set_header Host              $host;
#   proxy_set_header X-Real-IP         $remote_addr;
#   proxy_set_header X-Forwarded-For   $remote_addr;
#   proxy_set_header X-Forwarded-Proto $scheme;
# Without both, every visitor looks like nginx itself: tested, three different
# people were counted as ONE visitor, and the contact form's per-connection
# limits would block real guests together.
# Behind Cloudflare use  cf-connecting-ip  instead. On Vercel leave it unset.
TRUSTED_IP_HEADER=

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Absolute public URL, used for canonical links, Open Graph tags, the sitemap,
# robots.txt and the links in emails. On a VPS set it to the live domain; it is
# read when the site is built, so rebuild after changing it. Defaults to
# https://chefamritpalsingh.com. (On Vercel it can be left unset.)
NEXT_PUBLIC_SITE_URL=

# The port the app listens on; nginx's proxy_pass points here. Default 3000.
PORT=

# Optional. Search-console ownership codes, written into every page's <head>
# as verification meta tags. From Google Search Console ("HTML tag" method)
# and Bing Webmaster Tools. Leave unset until the domain is added there.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Set to "true" to show draft journal articles and placeholder content that is
# hidden by default. Leave unset in production.
NEXT_PUBLIC_SHOW_PLACEHOLDERS=

# ---------------------------------------------------------------------------
# Dashboard (/admin)
# ---------------------------------------------------------------------------
# With neither of these set, /admin cannot be signed in to at all: the login
# screen explains what to set and nothing behind it renders.

# Preferred. Generate with:  npm run admin:password
# The password itself is never stored — this is a scrypt hash of it.
# This is the password the site starts with. The chef can change it from the
# dashboard (Account > Change password); after that, this value no longer
# signs in. If the dashboard password is forgotten, put a NEW hash here and
# redeploy: a changed value here always wins, and the dashboard's is dropped.
ADMIN_PASSWORD_HASH=

# Accepted instead of the hash, for a quick local start. Anything that can read
# this server's environment can sign in with it, so prefer the hash in production.
# Note: a literal $ in any value here is read as a variable reference and has to
# be escaped as \$ — which is why the generated hash above contains none.
ADMIN_PASSWORD=

# Optional. Signs the session cookie. When unset it is derived from the
# credential above. Changing the password signs every open session out
# whether or not this is set; set it to keep sessions across a rotation of
# the hash above that is NOT meant as a password change (e.g. a copy-paste).
# Generate with:  openssl rand -base64 32
ADMIN_SESSION_SECRET=

# ---------------------------------------------------------------------------
# Dashboard storage
# ---------------------------------------------------------------------------
# Where the dashboard keeps content edits, visitor numbers and uploaded photos.
#
# On a VPS: plain files in DATA_DIR (further down), backed up daily. No
# database is needed. Leave the three Vercel-only keys below EMPTY.
#
# Vercel only: Upstash Redis + Vercel Blob. Vercel's disk is read-only, so files
# cannot work there. In the Vercel project, open Storage, create (or connect)
# an Upstash for Redis database and a Blob store, and connect both to this
# project. Vercel then adds these variables itself; there is nothing to copy
# by hand. Without them the live dashboard opens but says saving is off.
#
#   KV_REST_API_URL / KV_REST_API_TOKEN   (some setups name these
#                                          UPSTASH_REDIS_REST_URL / _TOKEN;
#                                          either pair works)
#   BLOB_READ_WRITE_TOKEN
#
# To copy the dashboard data from this computer to the live site once, put
# the three values above in .env.local and run:  npm run data:migrate
KV_REST_API_URL=
KV_REST_API_TOKEN=
BLOB_READ_WRITE_TOKEN=

# Optional. "cloud" or "files". The default is cloud on Vercel and files
# everywhere else, even when the keys above are in .env.local, so a dev server
# on a laptop never edits the live site's data by accident. On a VPS "files"
# (the default) is right. Set to "cloud" only to test the cloud storage
# locally on purpose.
DASHBOARD_STORE=

# Files only (a VPS). The folder the dashboard's data is kept in. Defaults to
# .data inside the app, which a deploy that replaces the app folder deletes —
# so on a VPS set it to a folder OUTSIDE the app. The server warns at startup
# in production when it is unset.        e.g. /var/lib/chef-site/data
DATA_DIR=

# Optional, files only. The server backs the folder above up by itself once a
# day, in production, keeping DATA_BACKUP_KEEP days (30). Backups go beside it
# in <DATA_DIR>-backups unless DATA_BACKUP_DIR says otherwise; a second disk is
# best. DATA_BACKUPS=off stops them, =on runs them in development too.
# Restore with:  npm run data:restore
DATA_BACKUP_DIR=
DATA_BACKUP_KEEP=
DATA_BACKUPS=

# ---------------------------------------------------------------------------
# Assistant (OpenAI)
# ---------------------------------------------------------------------------
# Powers the "Ask Angel" chat widget. Server-side only: never prefix this with
# NEXT_PUBLIC_, which would inline the key into the browser bundle. Get one from
# https://platform.openai.com/api-keys
#
# Without it the assistant still opens and answers, but replies with the
# restaurant's phone and email instead of calling the model.
OPENAI_API_KEY=
