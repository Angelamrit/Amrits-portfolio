# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the template, which carries no secrets, is meant to be committed.
!.env.example

# dashboard data: visit logs, content overrides and uploaded photography.
# Site content that should ship with the code lives in src/data; this is the
# chef's own edits and his visitors' numbers, and neither belongs in git.
/.data/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
